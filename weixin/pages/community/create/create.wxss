/* 农情上报 · 发布页 · 田园晨野 */

.container {
  padding: 16rpx 24rpx 0;
  background: var(--paper);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 导语 */
.page-lead {
  padding: 8rpx 12rpx 20rpx;
}

.page-lead-text {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* ============ 分组大卡：基本信息 / 补充信息 ============ */
.group-card {
  background: var(--card);
  border: 1rpx solid var(--card-bd);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 2rpx rgba(60, 52, 30, 0.04), 0 6rpx 18rpx rgba(60, 52, 30, 0.05);
}

.group-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 20rpx;
  margin-bottom: 24rpx;
  border-bottom: 0.5rpx solid var(--hairline);
}

.group-label-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.group-label-hint {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 字段行：组内用间距分隔，不再一张卡套一张卡 */
.field {
  margin-bottom: 28rpx;
}

.field-last {
  padding-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.form-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.req {
  color: var(--clay);
  font-weight: 600;
}

.label-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 400;
  margin-left: 8rpx;
}

/* 字数计数：接近上限转陶红提醒 */
.char-count {
  font-size: 22rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.char-count.char-warn {
  color: var(--clay);
  font-weight: 600;
}

/* ============ 类型选择：颜色即类型（与列表页 type-tag 语义一致） ============ */
.type-picker {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.type-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: var(--paper);
  border: 2rpx solid var(--card-bd);
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 600;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.type-option.opt-hover {
  background: #F1EDDD;
}

.type-icon {
  font-size: 30rpx;
  line-height: 1;
}

/* 选中态：语义 tint 底 + 语义色字与描边 */
.type-option.selected {
  background: var(--g-tint);
  color: var(--g600);
  border-color: var(--g600);
}

.type-pest.selected {
  background: var(--clay-tint);
  color: var(--clay);
  border-color: var(--clay);
}

.type-disaster.selected {
  background: var(--gold-tint);
  color: var(--gold-deep);
  border-color: var(--gold-deep);
}

.type-growth.selected {
  background: var(--g-tint);
  color: var(--g600);
  border-color: var(--g600);
}

.type-help.selected {
  background: rgba(62, 110, 143, 0.12);
  color: #3E6E8F;
  border-color: #3E6E8F;
}

/* ============ 输入框：描边式（米色填充在白卡内显脏） ============ */
.form-input {
  font-size: 28rpx;
  padding: 20rpx 24rpx;
  background: transparent;
  border: 2rpx solid var(--hairline);
  border-radius: 16rpx;
  color: var(--ink);
  transition: border-color 0.15s ease;
}

.form-textarea {
  font-size: 28rpx;
  padding: 20rpx 24rpx;
  background: transparent;
  border: 2rpx solid var(--hairline);
  border-radius: 16rpx;
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  color: var(--ink);
  line-height: 1.6;
  transition: border-color 0.15s ease;
}

.input-placeholder {
  color: #C0BBAB;
}

/* ============ AI 帮我整理：金调描边胶囊，与底部深绿提交按钮区分层级 ============ */
.ai-polish {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.ai-polish-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: var(--gold-tint);
  border: 2rpx solid rgba(160, 126, 20, 0.35);
  transition: background 0.15s ease, opacity 0.15s ease;
}

.ai-polish-btn-hover {
  background: #EBDCB0;
}

/* 思考中：压暗并阻断重复点击的视觉反馈 */
.ai-polish-btn.is-busy {
  opacity: 0.6;
}

.ai-polish-icon {
  font-size: 24rpx;
  line-height: 1;
}

.ai-polish-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold-deep);
  letter-spacing: 1rpx;
}

.ai-polish-hint {
  flex: 1;
  min-width: 200rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

/* ============ AI 初步建议卡：金浅底，与表单白区隔开 ============ */
.ai-suggest {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--gold-tint);
  border-radius: 16rpx;
}

.ai-suggest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ai-suggest-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--gold-deep);
  letter-spacing: 1rpx;
}

.ai-suggest-fold {
  font-size: 22rpx;
  color: var(--ink-3);
}

.ai-suggest-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink);
}

.ai-suggest-foot {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

/* ============ 照片 ============ */
.image-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.picked-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--hairline);
}

.remove-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(38, 51, 43, 0.72);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.add-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(160, 126, 20, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: var(--paper);
  transition: background 0.15s ease;
}

.add-image.add-hover {
  background: var(--gold-tint);
}

.add-icon {
  font-size: 44rpx;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ============ 选择器行 ============ */
.picker-value {
  font-size: 28rpx;
  padding: 20rpx 24rpx;
  background: transparent;
  border: 2rpx solid var(--hairline);
  border-radius: 16rpx;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background 0.15s ease;
}

.picker-value.picker-hover {
  background: var(--paper);
}

.picker-value.picker-selected {
  border-color: rgba(47, 107, 66, 0.45);
  color: var(--g600);
  font-weight: 600;
}

.picker-placeholder {
  color: #C0BBAB;
}

.picker-arrow {
  font-size: 32rpx;
  color: #C9C4B2;
  font-weight: 300;
  line-height: 1;
}

/* ============ 紧急程度 ============ */
.urgency-picker {
  display: flex;
  gap: 14rpx;
}

.urgency-option {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  background: var(--paper);
  border: 2rpx solid var(--card-bd);
  color: var(--ink-2);
  font-weight: 600;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.urgency-option.opt-hover {
  background: #F1EDDD;
}

.selected-low {
  background: var(--g-tint);
  color: var(--g600);
  border-color: var(--g600);
}

.selected-medium {
  background: var(--gold-tint);
  color: var(--gold-deep);
  border-color: var(--gold-deep);
}

.selected-high {
  background: var(--clay-tint);
  color: var(--clay);
  border-color: var(--clay);
}

/* ============ 底部固定提交栏（不再藏在页面流里） ============ */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--card-bd);
  box-shadow: 0 -2rpx 12rpx rgba(60, 52, 30, 0.06);
  z-index: 100;
}

.submit-bar-safe {
  height: 180rpx;
}

.submit-btn {
  background: linear-gradient(160deg, #2F6B42, #3D7A50);
  color: #fff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 1.5;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 14rpx rgba(47, 107, 66, 0.28);
  transition: opacity 0.15s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

/* 清除微信 button 默认边框伪元素 */
.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.85;
}
