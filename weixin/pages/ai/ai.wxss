.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F1E8;
  box-sizing: border-box;
}

/* ============= 顶部模式切换 ============= */
.mode-switcher {
  background: #FDFCF8;
  padding: 16rpx 24rpx 0;
  border-bottom: 0.5rpx solid rgba(38, 51, 43, 0.07);
}
.mode-tabs {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.mode-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #F4F1E8;
  border: 1rpx solid transparent;
  color: var(--ink-3);
  font-size: 28rpx;
  font-weight: 500;
  transition: background-color, border-color, color, box-shadow, opacity 0.2s ease;
}
.mode-tab.mode-active {
  background: linear-gradient(135deg, #2F6B42, #27573C);
  color: #F4F1E8;
  box-shadow: 0 4rpx 14rpx rgba(47, 107, 66, 0.28);
}
/* 人工专家 tab 激活态走稻谷金 */
.mode-tab.expert-tab.mode-active {
  background: linear-gradient(135deg, #A07E14, #8A6A0F);
  color: #F4F1E8;
  box-shadow: 0 4rpx 14rpx rgba(160, 126, 20, 0.3);
}
.mode-icon { display: flex; align-items: center; justify-content: center; }
.mode-label { font-size: 28rpx; letter-spacing: 0.3rpx; }
.mode-expert-dot {
  position: absolute;
  top: 6rpx; right: 10rpx;
  min-width: 32rpx; height: 32rpx; padding: 0 8rpx;
  border-radius: 16rpx;
  background: #B0452B;
  color: #fff;
  font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(176, 69, 43, 0.3);
}

.human-status-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 4rpx 18rpx;
  font-size: 26rpx;
}
.status-dot {
  display: inline-block; width: 14rpx; height: 14rpx;
  border-radius: 50%; margin-right: 10rpx; vertical-align: middle;
}
.status-dot.green  { background: #2F6B42; }
.status-dot.orange { background: #A07E14; }
.status-dot.blue   { background: #2F6B42; }
.status-dot.gray   { background: #C9C4B2; }
.status-dot.pulse  {
  box-shadow: 0 0 0 rgba(201, 134, 30, 0.6);
  animation: statusPulse 1.6s infinite;
}
.status-dot.blue.pulse {
  box-shadow: 0 0 0 rgba(47, 107, 66, 0.6);
  animation: statusPulseBlue 1.6s infinite;
}
@keyframes statusPulse {
  0%   { box-shadow: 0 0 0 0  rgba(201, 134, 30, 0.6); }
  70%  { box-shadow: 0 0 0 14rpx rgba(201, 134, 30, 0); }
  100% { box-shadow: 0 0 0 0  rgba(201, 134, 30, 0); }
}
@keyframes statusPulseBlue {
  0%   { box-shadow: 0 0 0 0  rgba(47, 107, 66, 0.6); }
  70%  { box-shadow: 0 0 0 14rpx rgba(47, 107, 66, 0); }
  100% { box-shadow: 0 0 0 0  rgba(47, 107, 66, 0); }
}
.status-text { color: #6B6F63; opacity: 0.8; }
.status-actions { display: flex; gap: 16rpx; }
.status-action-btn {
  font-size: 24rpx;
  color: #B0452B;
  padding: 6rpx 16rpx;
  background: rgba(176, 69, 43, 0.08);
  border-radius: 20rpx;
}
.status-action-btn.primary {
  color: #2F6B42;
  background: rgba(47, 107, 66, 0.1);
}

/* ============= 消息主体 ============= */
.chat-messages {
  flex: 1;
  padding: 24rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  animation: msgFadeIn 0.25s ease-out;
  align-items: flex-start;
}
@keyframes msgFadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.msg-user { justify-content: flex-end; }
.msg-ai   { justify-content: flex-start; }

.msg-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; flex-shrink: 0;
}
.ai-avatar {
  background: linear-gradient(135deg, #2F6B42, #1E4634);
  color: #F4F1E8; margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(47, 107, 66, 0.3);
}
.human-avatar {
  background: linear-gradient(135deg, #C9A227, #A07E14);
  color: #F4F1E8; margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(160, 126, 20, 0.3);
}
.system-avatar {
  background: transparent;
  width: 40rpx; height: 40rpx; font-size: 26rpx;
  margin-right: 12rpx;
}
.user-avatar {
  background: linear-gradient(135deg, #2F6B42, #27573C); color: #F4F1E8; margin-left: 16rpx;
  font-weight: 600; font-size: 26rpx;
}

.msg-bubble-wrap {
  display: flex; flex-direction: column;
  max-width: 72%;
}
.msg-user .msg-bubble-wrap { align-items: flex-end; }

.msg-role-tag {
  font-size: 22rpx; color: var(--ink-3);
  margin-bottom: 6rpx; margin-left: 2rpx;
}

/* 气泡时间小字（专家署名行内 / 用户气泡下方） */
.msg-time {
  font-size: 20rpx;
  color: #B5B0A0;
  margin-left: 10rpx;
}

.msg-time-right {
  text-align: right;
  margin-top: 6rpx;
  margin-right: 2rpx;
}

.msg-bubble {
  max-width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  line-height: 1.6;
}
.ai-bubble {
  background: #FDFCF8;
  border: 1rpx solid rgba(38, 51, 43, 0.06);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  box-shadow: 0 1rpx 4rpx rgba(38, 51, 43, 0.05);
}
.human-bubble {
  background: linear-gradient(135deg, #FBF6E4, #F5EDD2);
  border: 1rpx solid rgba(160, 126, 20, 0.18);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  box-shadow: 0 1rpx 4rpx rgba(160, 126, 20, 0.06);
}
.system-bubble {
  background: transparent;
  color: var(--ink-3);
  padding: 6rpx 4rpx;
  max-width: 100%;
}
.user-bubble {
  background: linear-gradient(135deg, #2F6B42, #27573C);
  border-radius: 20rpx 20rpx 6rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(47, 107, 66, 0.24);
}

.msg-text {
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
  letter-spacing: 0.2rpx;
}
.ai-bubble .msg-text { color: #26332B; }
.human-bubble .msg-text { color: #3D3422; }
.user-bubble .msg-text { color: #F4F1E8; }
.system-bubble .msg-text { font-size: 26rpx; color: var(--ink-3); }

.msg-richtext {
  word-break: break-word;
  font-size: 30rpx;
  line-height: 1.6;
}
.msg-richtext-plain {
  font-size: 30rpx;
  color: #26332B;
  line-height: 1.65;
}

/* 欢迎语 */
.welcome-bubble {
  background: #FDFCF8 !important;
  padding: 28rpx 28rpx !important;
  max-width: 86% !important;
}
.welcome-title {
  font-size: 32rpx; font-weight: 700; color: #26332B;
  margin-bottom: 12rpx; letter-spacing: -0.3rpx;
}
.welcome-desc {
  font-size: 28rpx; color: #6B6F63; opacity: 0.65;
  line-height: 1.6; margin-bottom: 20rpx;
}
.welcome-list { display: flex; flex-direction: column; gap: 12rpx; }
.welcome-item {
  font-size: 28rpx; color: #2F6B42;
  padding: 14rpx 18rpx;
  background: rgba(47, 107, 66, 0.07);
  border: 1rpx solid rgba(47, 107, 66, 0.12);
  border-radius: 12rpx; line-height: 1.4;
}
.welcome-item:active { background: rgba(47, 107, 66, 0.14); }

/* AI 思考 */
.typing-indicator {
  display: flex; align-items: center; gap: 10rpx; padding: 4rpx 0;
}
.typing-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #2F6B42;
  animation: typingBounce 1.2s infinite;
}
.typing-dot:nth-child(2) { animation-delay: 0.15s; }
.typing-dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes typingBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30%          { transform: translateY(-8rpx); opacity: 1; }
}

/* 人工欢迎卡片（稻谷金） */
.human-welcome-card {
  display: flex; gap: 20rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #FDFCF8 0%, #F5EDD2 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(160, 126, 20, 0.16);
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(160, 126, 20, 0.08);
}
.hwc-icon {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: linear-gradient(135deg, #C9A227, #A07E14);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: #F4F1E8; flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(160, 126, 20, 0.3);
}
.hwc-main { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.hwc-title { font-size: 30rpx; font-weight: 700; color: #26332B; }
.hwc-desc  { font-size: 26rpx; color: #6B6F63; opacity: 0.75; line-height: 1.5; }
.hwc-info  { font-size: 22rpx; color: #8A6A0F; opacity: 0.85; }
.hwc-btn {
  align-self: flex-start;
  display: flex; align-items: center; gap: 8rpx;
  margin-top: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #C9A227, #A07E14);
  color: #F4F1E8;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(160, 126, 20, 0.35);
}
.hwc-btn:active { transform: scale(0.96); }
.hwc-btn-ic { flex-shrink: 0; }

/* 快捷区 */
.quick-section { margin-top: 12rpx; padding: 0 4rpx; }
.quick-section-title {
  font-size: 24rpx; font-weight: 600; color: var(--ink-3);
  letter-spacing: 0.5rpx; margin-bottom: 16rpx; padding-left: 4rpx;
}
.quick-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx;
}
.quick-item {
  display: flex; flex-direction: column; align-items: flex-start;
  background: #FDFCF8; padding: 22rpx 20rpx; border-radius: 16rpx;
  border: 1rpx solid rgba(38, 51, 43, 0.05);
  box-shadow: 0 1rpx 3rpx rgba(38, 51, 43, 0.04);
  transition: transform, opacity, background-color, box-shadow, color 0.2s ease;
}
.quick-item:active { transform: scale(0.97); background: #F4F1E8; }
.quick-icon-view {
  width: 56rpx; height: 56rpx; border-radius: 14rpx;
  background: rgba(47, 107, 66, 0.09);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 12rpx;
}
.quick-text { font-size: 26rpx; color: #26332B; font-weight: 500; line-height: 1.3; }

.bottom-spacer { height: 20rpx; }

/* 输入栏 */
.chat-input-bar {
  display: flex; align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: rgba(253, 252, 248, 0.92);
  backdrop-filter: blur(20rpx);
  border-top: 0.5rpx solid rgba(38, 51, 43, 0.07);
  gap: 16rpx;
}
.chat-input {
  flex: 1; height: 72rpx; background: #F4F1E8;
  border: 1rpx solid rgba(38, 51, 43, 0.06);
  border-radius: 36rpx; padding: 0 28rpx;
  font-size: 30rpx; color: #26332B;
}
.input-placeholder { color: var(--ink-3); }

.send-btn {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #C9C4B2;
  display: flex; align-items: center; justify-content: center;
  transition: transform, opacity, background-color, box-shadow, color 0.2s; flex-shrink: 0;
}
.send-btn-active {
  background: linear-gradient(135deg, #2F6B42, #27573C);
  box-shadow: 0 4rpx 12rpx rgba(47, 107, 66, 0.32);
}
.send-btn:active { transform: scale(0.92); }
.send-icon { color: #F4F1E8; font-size: 36rpx; font-weight: 700; }
