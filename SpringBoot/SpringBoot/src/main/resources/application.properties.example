spring.application.name=agri-weather-service
server.port=8082
server.address=0.0.0.0

spring.datasource.url=jdbc:mysql://localhost:3306/agri_weather?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
spring.datasource.username=root
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.time_zone=Asia/Shanghai

# ===== 缓存：Redis =====
spring.cache.type=redis
spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.password=
spring.data.redis.timeout=3s
spring.data.redis.connect-timeout=3s

spring.jackson.time-zone=Asia/Shanghai

# JWT：secret 至少 32 字节
jwt.secret=
jwt.expiration=86400000

# WeChat Mini Program
wechat.appid=
wechat.secret=
# dev-mode=true 时跳过微信 code2session，直接用传入的 openid，便于本地联调
wechat.dev-mode=true

# WeChat Subscribe Message Template IDs
# 在微信公众平台 -> 功能 -> 订阅消息 中添加模板后获取；留空则只记日志不发送
# 灾害预警模板字段：time1(预警时间), short_thing2(预警类型,最多5字), thing3(预警内容), short_thing4(预警等级,最多5字), thing5(预警地点)
wechat.template.warning=
# 农事提醒模板字段：time1(提醒时间), thing2(操作事项,最多20字)
wechat.template.farming=

# Amap
amap.key=

# File upload
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=10MB
app.upload.path=./weather-uploads

# AI Chat - 云端大模型 + 天气上下文注入 + RAGFlow 知识库检索
# 走 OpenAI 兼容协议，换服务商只改这几行；留空时可在后台「系统设置」里填
ai.api-key=
ai.base-url=https://api.deepseek.com/v1
ai.model=deepseek-chat
ai.max-tokens=1024
ai.temperature=0.7

# RAGFlow 农业知识库检索（RAG 的 Retrieval 一侧，生成仍由本服务负责）
# 默认关闭：RAGFlow 跑在 Docker 里，不保证常驻；关闭时系统行为与接入前完全一致
ragflow.enabled=false
ragflow.base-url=http://localhost:9380
ragflow.api-key=
ragflow.dataset-id=
# 本知识库命中分数大致 0.25—0.38，口语化提问（如「下田打药」）会低到 0.1 以下：
# 阈值定 0.08 是宁可多召回一条让模型自己筛，也不要把有用的片段滤掉
ragflow.top-k=5
ragflow.score-threshold=0.08
